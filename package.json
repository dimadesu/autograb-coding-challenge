{
  "name": "autograb-coding-challenge",
  "version": "0.1.0",
  "author": "Dmytro Antonov",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm --prefix client run build",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run preview",
    "start": "npm run build && concurrently -n server,client -c blue,green \"npm:start:server\" \"npm:start:client\"",
    "test": "npm --prefix server test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.10.1"
  }
}
